{
	"schemaVersion": 1,
	"id": "sp0k-hud",
	"version": "${version}",
	"name": "Sp0k's HUD+",
	"description": "A lightweight client-side HUD mod for Minecraft that displays useful information to the player.",
	"authors": [
		"Sp0k_"
	],
	"contact": {
		"homepage": "https://gabsavard.com/",
		"sources": "https://github.com/Sp0k/Sp0kHud"
	},
	"license": "CC0-1.0",
	"icon": "assets/sp0k-hud/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gabsavard.spokhud.Sp0kHUD"
		],
		"client": [
			"com.gabsavard.spokhud.client.Sp0kHUDClient"
		],
		"fabric-datagen": [
			"com.gabsavard.spokhud.client.Sp0kHUDDataGenerator"
		],
		"modmenu": [
			"com.gabsavard.spokhud.client.Sp0kHUDModMenu"
		]
	},
	"mixins": [
		"sp0k-hud.mixins.json",
		{
			"config": "sp0k-hud.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}